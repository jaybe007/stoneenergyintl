# =====================================================================
# STONE ENERGY INT'L LTD - Environment Configuration
# =====================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/stoneenergyintl
APP_KEY=se_sec_key_production_replace_this_with_random_32_bytes

# Database Configuration (MySQL / MariaDB via PDO)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stoneenergy_db
DB_USER=root
DB_PASS=

# SMTP Mail Server Configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@stoneenergyintl.com
MAIL_FROM_NAME="STONE ENERGY INT'L LTD"

# Security & Session Settings
SESSION_LIFETIME=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
